# AtlasX E2E Test Configuration

# API Configuration
API_BASE_URL=http://localhost:3000

# Plaid Configuration (for Open Banking tests)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_PUBLIC_KEY=your_plaid_public_key
PLAID_ENV=sandbox

# Firebase Configuration (for Push Notification tests)
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=your_firebase_project_id

# Database Configuration (if direct DB access needed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlasx_test
DB_USER=postgres
DB_PASSWORD=postgres

# Test Configuration
TEST_TIMEOUT=30000
TEST_MAX_RETRIES=3
TEST_RETRY_DELAY=1000

# Feature Flags
ENABLE_P2P_LENDING_TESTS=true
ENABLE_OPEN_BANKING_TESTS=true
ENABLE_OAUTH2_TESTS=true
ENABLE_WEBHOOK_TESTS=true
ENABLE_INTEGRATION_TESTS=true

# Test User Credentials
TEST_USER_PASSWORD=Test123!@#

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Webhook Test Server
WEBHOOK_TEST_PORT=4000

# Logging
LOG_LEVEL=info
LOG_TESTS=true
