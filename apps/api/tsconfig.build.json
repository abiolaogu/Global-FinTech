{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": false
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/platform/**/*.ts",
    "src/common/decorators/roles.decorator.ts",
    "src/common/guards/jwt-auth.guard.ts",
    "src/common/guards/roles.guard.ts",
    "src/modules/admin/**/*.ts",
    "src/modules/ai-chat/**/*.ts",
    "src/modules/auth/**/*.ts",
    "src/modules/investments/**/*.ts",
    "src/modules/marketplace/**/*.ts",
    "src/modules/notifications/**/*.ts",
    "src/modules/payment-engine/**/*.ts",
    "src/modules/payment-links/**/*.ts",
    "src/modules/wallets/**/*.ts",
    "src/modules/split-payments/**/*.ts",
    "src/modules/payment-gateways/**/*.ts",
    "src/modules/realtime-payments/**/*.ts",
    "src/modules/recurring-payments/**/*.ts",
    "src/modules/rosca/**/*.ts",
    "src/modules/virtual-accounts/**/*.ts",
    "src/modules/users/entities/**/*.ts",
    "src/modules/payments/entities/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts"
  ]
}
